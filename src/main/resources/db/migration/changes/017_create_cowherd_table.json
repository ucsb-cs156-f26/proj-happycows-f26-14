
{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "017-create-cowherd-table",
        "author": "heloisaalcantarafurtado",
        "preConditions": [
          {
            "onFail": "MARK_RAN"
          },
          {
            "not": [
              {
                "tableExists": {
                  "tableName": "cowherd"
                }
              }
            ]
          }
        ],
        "changes": [
          {
            "createTable": {
              "tableName": "cowherd",
              "columns": [
                {
                  "column": {
                    "name": "id",
                    "type": "BIGINT",
                    "autoIncrement": true,
                    "constraints": {
                      "primaryKey": true,
                      "primaryKeyName": "COWHERD_PK",
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "farmer_user_id",
                    "type": "BIGINT",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "farmer_game_id",
                    "type": "BIGINT",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "num_of_cows",
                    "type": "INT",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "cow_health",
                    "type": "DOUBLE PRECISION",
                    "constraints": {
                      "nullable": false
                    }
                  }
                }
              ]
            }
          },
          {
            "addForeignKeyConstraint": {
              "baseTableName": "cowherd",
              "baseColumnNames": "farmer_game_id,farmer_user_id",
              "referencedTableName": "farmer",
              "referencedColumnNames": "game_id,user_id",
              "constraintName": "FK_COWHERD_FARMER",
              "onDelete": "RESTRICT",
              "onUpdate": "RESTRICT"
            }
          }
        ]
      }
    }
  ]
}
